#!/usr/bin/env bash
#SBATCH --job-name=phylo-scale
#SBATCH --constraint=skl|agg
#SBATCH --cpus-per-task=25
#SBATCH --mem=24G
#SBATCH --tmp=20G
#SBATCH --time=4:00:00
# Sets the unit factor c in params.json (docs/dev/phylo-calibration-design.md): simulate 50
# null genes (N0, L50), fit them with phylo_busted, and compare only the median fitted tree
# length with the empirical median. p-values are not read. Up to 4 rounds; stops within 5%.
#   DNDSR_SIF=<image> DNDSR_DEV_LIB=<lib> sbatch phylo-calibration-scale.sb <params.json in> <params.json out>
set -euo pipefail
in=$(realpath "$1"); final=$(realpath -m "$2")
repo=${SLURM_SUBMIT_DIR:-$PWD}
work=${TMPDIR:-/tmp}/phylo-scale-${SLURM_JOB_ID:-$$}
mkdir -p "$work"; trap 'rm -rf "$work"' EXIT
cd "$work"; cp "$in" params.json
run() { singularity exec --cleanenv --bind "$repo" --bind "$work" --bind "$DNDSR_DEV_LIB" --pwd "$PWD" --env "R_LIBS_USER=$DNDSR_DEV_LIB" "$DNDSR_SIF" "$@"; }
for round in 1 2 3 4; do
  rm -rf sim
  run Rscript --vanilla "$repo/tools/dev/validation/phylo-sim.R" params.json N0_L50 50 $((9000 + round)) sim
  run Rscript --vanilla -e 'dndsR::cli_main()' -- phylo_busted --alignment-dir sim/alignments --species-tree-file sim/species_tree.nwk \
    --foreground-file sim/foreground.tsv -o sim -t "${SLURM_CPUS_PER_TASK:-8}" > /dev/null 2>&1 || true
  verdict=$(run Rscript --vanilla -e '
    p <- jsonlite::read_json("params.json", simplifyVector = TRUE)
    r <- read.delim("sim/busted/busted_results.tsv")
    obs <- median(r$tree_length[r$status == "tested"]); ratio <- p$empirical_tree_length_median / obs
    cat(sprintf("c %.4f, simulated median tree length %.4f, empirical %.4f, ratio %.4f\n", p$c, obs, p$empirical_tree_length_median, ratio), file = stderr())
    if (abs(ratio - 1) <= 0.05) cat("done") else { p$c <- p$c * ratio; jsonlite::write_json(p, "params.json", auto_unbox = TRUE, digits = NA, pretty = TRUE); cat("again") }' 2>>"$work/log")
  echo -n "round $round: "; cat log; : > log
  [ "$verdict" = done ] && break
done
cp params.json "$final"
echo "final c: $(grep '"c"' params.json)"
