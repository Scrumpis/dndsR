#!/bin/bash --login
# Study N follow-up (docs/dev/enrichment-error-study.md, "Follow-up: the worst cell"): runs of the
# strata5 reassignment at A. thaliana-A. lyrata through enrichment-methods.R (every candidate,
# including pb_floor = covariate_enrichment), seeds FIRST + (task - 1) * PER ... + PER - 1.
#   sbatch --array=1-20 --export=ALL,ROOT=<study-N root>,IMAGE=<sif>,FIRST=970000,PER=50 enrichment-worstcell.sb
#SBATCH --time=12:00:00
#SBATCH --cpus-per-task=1
#SBATCH --mem=6G
#SBATCH --job-name=enrich-worst
set -euo pipefail
: "${ROOT:?}" "${IMAGE:?}" "${FIRST:?}" "${PER:?}"
v="$ROOT/src/tools/dev/validation"; out="$ROOT/runs-worstcell"; mkdir -p "$out"
start=$((FIRST + (SLURM_ARRAY_TASK_ID - 1) * PER))
for ((s = start; s < start + PER; s++)); do
  [ -s "$out/terms_$s.tsv" ] && continue
  t0=$SECONDS
  singularity exec --cleanenv --bind "$ROOT" --env R_LIBS_USER="$ROOT/lib" "$IMAGE" Rscript --vanilla "$v/enrichment-methods.R" \
    "$ROOT/inputs/AtAl_dnds_annot.tsv" "$ROOT/inputs/go_ancestors.tsv" "strata5:$s" "$out/terms_$s.tmp"
  mv "$out/terms_$s.tmp" "$out/terms_$s.tsv"
  printf 'strata5\t%s\t%s\n' "$s" "$((SECONDS - t0))" >> "$out/timing_$SLURM_ARRAY_TASK_ID.tsv"
done
