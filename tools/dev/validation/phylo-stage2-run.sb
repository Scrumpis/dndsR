#!/usr/bin/env bash
#SBATCH --job-name=p3s2-run
#SBATCH --constraint=agg
#SBATCH --cpus-per-task=48
#SBATCH --mem=96G
#SBATCH --tmp=100G
#SBATCH --time=24:00:00
# Stage 2 analyses. Array task t of K runs units t, t+K, t+2K, ... of the unit table.
# Resumable: a unit with a matching DONE is skipped; a crashed unit has no DONE and reruns.
#   sbatch --array=0-<K-1> phylo-stage2-run.sb <results root> <K> [unit table]
# The table defaults to stage 2A's. An optional 7th column, fit, is "all" (default) or
# "changed:<base filter>": only alignments that differ from the base filter's are fitted,
# and the summary takes the others from the unit with the base filter (stage 2B). The first
# seed is HyPhy's --seed, the rest are --extra-seeds.
root=$(realpath "$1"); K=$2; table=${3:-phylo-stage2-units.tsv}
source "$root/src/tools/dev/validation/phylo-stage2-common.sh"
t=${SLURM_ARRAY_TASK_ID:?array job}
args_for() { case $1 in
  C0) echo "" ;; C1) echo "--multiple-hits Double" ;; C2) echo "--error-sink Yes" ;;
  C3) echo "--error-sink Yes --multiple-hits Double" ;; C4) echo "--multiple-hits Double+Triple" ;;
  *) echo "unknown configuration $1" >&2; return 1 ;; esac; }
# Budget guard (stage 2B): with <root>/budget_cap.txt present, a unit starts only if the core-
# hours already used (every unit's meta.tsv, and earlier attempts in <root>/ledger), plus the estimates of units running now, plus this
# unit's estimate (phylo-stage2b-estimates.tsv) stay within the cap. Otherwise the task stops
# and writes <root>/BUDGET_STOP; the unit stays undone and reruns once the cap is raised.
# A unit with a marker in <root>/running is claimed by another task and is skipped (return 2),
# so overlapping submissions cannot fit a unit twice; the submit script clears stale markers.
# P3S2_UNITS=full or changed runs only units with fit "all", or only "changed:" units.
guard() {
  [ -f "$root/budget_cap.txt" ] || return 0
  mkdir -p "$root/running"
  exec 9>"$root/budget.lock"; flock 9
  [ -e "$root/running/$1" ] && { flock -u 9; return 2; }
  local rc=0
  python3 -I - "$root" "$1" "$v/phylo-stage2b-estimates.tsv" <<'PY' || rc=$?
import csv, glob, os, sys
root, unit, estf = sys.argv[1:]
cap = float(open(os.path.join(root, "budget_cap.txt")).read().split()[0])
est = {r["unit"]: float(r["core_hours"]) for r in csv.DictReader(open(estf), delimiter="\t")}
used = 0.0
for m in glob.glob(os.path.join(root, "units", "*", "meta.tsv")) + glob.glob(os.path.join(root, "ledger", "*.tsv")):
    r = next(csv.DictReader(open(m), delimiter="\t"))
    used += float(r["seconds"]) * float(r["threads"]) / 3600
running = sum(float(open(f).read().split()[0]) for f in glob.glob(os.path.join(root, "running", "*")))
need = est.get(unit, 0.0)
total = used + running + need
if total > cap:
    open(os.path.join(root, "BUDGET_STOP"), "a").write(
        "%s: used %.1f + running %.1f + %s %.1f = %.1f > cap %.1f core-hours\n" % (unit, used, running, unit, need, total, cap))
    sys.exit(1)
open(os.path.join(root, "running", unit), "w").write("%s %s\n" % (need, os.environ.get("SLURM_JOB_ID", "-")))
PY
  flock -u 9; [ "$rc" = 0 ] && return 0 || return 1
}
case ${P3S2_UNITS:-all} in   # column 7, fit: empty or "all" for full fits, "changed:<base>" otherwise
  all) mapfile -t rows < <(tail -n +2 "$v/$table") ;;
  full) mapfile -t rows < <(tail -n +2 "$v/$table" | awk -F'\t' '$7 == "" || $7 == "all"') ;;
  changed) mapfile -t rows < <(tail -n +2 "$v/$table" | awk -F'\t' '$7 ~ /^changed:/') ;;
  *) echo "P3S2_UNITS must be all, full, or changed" >&2; exit 1 ;;
esac
for ((j = t; j < ${#rows[@]}; j += K)); do
  row=${rows[$j]}
  IFS=$'\t' read -r unit block scenario config filter seeds fit <<<"$row"; fit=${fit:-all}
  out=$root/units/$unit; h=$(spec_hash "$row")
  done_ok "$out" "$h" && { echo "skip $unit"; continue; }
  g=0; guard "$unit" || g=$?
  [ "$g" = 2 ] && { echo "skip $unit: claimed by another task"; continue; }
  [ "$g" = 0 ] || { echo "budget cap reached before $unit; stopping (see $root/BUDGET_STOP)"; break; }
  sim=$root/sim/$scenario
  [ -f "$sim/DONE" ] || { echo "no simulation for $scenario" >&2; exit 1; }
  aln=$sim/alignments; [ "$filter" = none ] || aln=$sim/filtered_$filter
  seed1=${seeds%%,*}; extra=(); [ "$seeds" = "$seed1" ] || extra=(--extra-seeds "${seeds#*,}")
  work=${TMPDIR:-/tmp}/p3s2-$unit; rm -rf "$work"; mkdir -p "$work"
  cd "$work"
  if [ "$fit" != all ]; then   # fit only the alignments this filter changed
    base=${fit#changed:}; bdir=$sim/alignments; [ "$base" = none ] || bdir=$sim/filtered_$base
    mkdir -p "$work/changed"
    for f in "$aln"/*.fasta; do b=$(basename "$f")
      cmp -s "$f" "$bdir/$b" || cp "$f" "$work/changed/"
    done
    ls "$work/changed" > "$work/changed.txt"
    aln=$work/changed
    if [ ! -s "$work/changed.txt" ]; then   # nothing changed: no fit; the summary uses the base unit
      rm -rf "$out"; mkdir -p "$out"; cp "$work/changed.txt" "$out/"
      printf 'unit\tstart_utc\tseconds\tthreads\thost\tcpu\texit_code\tcommit\n%s\t%s\t0\t%s\t%s\t%s\t0\t%s\n' \
        "$unit" "$(date -u +%FT%TZ)" "$threads" "$(hostname)" "$(cpu_model)" "$commit" > "$out/meta.tsv"
      echo "$h" > "$out/DONE"; rm -f "$root/running/$unit"; cd /; rm -rf "$work"; echo "$unit nothing changed"; continue
    fi
  fi
  start=$(date -u +%FT%TZ); s0=$SECONDS
  set +e
  # shellcheck disable=SC2046
  dndsr phylo_busted --alignment-dir "$aln" --species-tree-file "$sim/species_tree.nwk" \
    --foreground-file "$sim/foreground.tsv" -o "$work" --run-name "$unit" -t "$threads" --seed "$seed1" \
    $(args_for "$config") "${extra[@]}" > run.log 2>&1
  rc=$?; set -e
  secs=$((SECONDS - s0))
  # A rerun replaces the unit's folder; keep the earlier attempt's cost in the ledger.
  [ -f "$out/meta.tsv" ] && { mkdir -p "$root/ledger"; cp "$out/meta.tsv" "$root/ledger/$unit.$(date +%s).tsv"; }
  rm -rf "$out"; mkdir -p "$out"
  cp run.log "$out/"; [ -f "$work/changed.txt" ] && cp "$work/changed.txt" "$out/"
  cp "$work/$unit/${unit}_results.tsv" "$work/$unit/${unit}_provenance.json" "$out/" 2>/dev/null || true
  [ -d "$work/$unit/hyphy" ] && tar -czf "$out/hyphy_raw.tar.gz" -C "$work/$unit" hyphy
  printf 'unit\tstart_utc\tseconds\tthreads\thost\tcpu\texit_code\tcommit\n%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$unit" "$start" "$secs" "$threads" "$(hostname)" "$(cpu_model)" "$rc" "$commit" > "$out/meta.tsv"
  # DONE only for a complete run; the summary counts and classifies everything else.
  [ "$rc" = 0 ] && [ -f "$out/${unit}_results.tsv" ] && echo "$h" > "$out/DONE"
  rm -f "$root/running/$unit"; cd /; rm -rf "$work"
  echo "$unit rc=$rc ${secs}s"
done
