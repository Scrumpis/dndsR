#!/bin/sh
# dndsR hook: only fast-forward pushes of dev are allowed, and the skill must validate.
. "$(dirname "$0")/_common.sh"
top=$(git rev-parse --show-toplevel)

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "${remote_ref:-}" ] || continue
  log_git_event push-attempt "$local_sha" "$remote_ref"
  [ "$remote_ref" = "$DEV_BRANCH" ] || block "pushing to $remote_ref (only $DEV_BRANCH is allowed)"
  [ "$local_sha" != "$ZERO" ] || block "deleting dev on the remote"
  [ "$remote_sha" != "$ZERO" ] || block "creating dev on the remote (it should already exist)"
  git cat-file -e "$remote_sha^{commit}" 2>/dev/null ||
    block "remote dev has commits missing locally; run: git fetch origin"
  git merge-base --is-ancestor "$remote_sha" "$local_sha" ||
    block "non-fast-forward push to dev (force-push rewrites shared history)"
done

if [ ! -f "$top/tools/dev/validate-skill.R" ]; then
  echo "dndsR policy: WARNING: validator absent on this checkout; skill validation skipped" >&2
elif command -v Rscript >/dev/null 2>&1; then
  Rscript --vanilla "$top/tools/dev/validate-skill.R" "$top" >&2 || block "skill validation failed"
else
  echo "dndsR policy: WARNING: Rscript not found; skill validation skipped" >&2
fi
